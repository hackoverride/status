# Copy this file to .env and fill it in. .env is gitignored - it never gets
# committed, which is the point: cluster tokens, connection strings and
# service URLs live there, not in the repo.
#
# Format: plain KEY=VALUE lines. List entries are numbered and hold their own
# `field=value` pairs separated by semicolons, so field order doesn't matter
# and optional fields can just be left out. The numbering only sets the order
# entries are read in - gaps are fine. Values must not contain a semicolon -
# which is why secrets get a line of their own (..._TOKEN, ..._CONNECTION_STRING).
#
# See the comment block at the top of config.js for what every field means.

# --- setup ---------------------------------------------------------------
# All optional; the defaults shown here are what you get if you omit them.

PORT=8080
REFRESH_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=5
# The history bar: how far back it reaches, and how many minutes each segment
# of it covers. 24 h of 30 min = 48 segments.
HISTORY_HOURS=24
HISTORY_BAR_MINUTES=30
# How long the raw check log is kept. Must cover HISTORY_HOURS.
RETENTION_DAYS=10

# --- sections of the page, top to bottom ---------------------------------
# SECTION_<n>=key=<key>; label=<heading>; sublabel=<small text after it>
#   key      REQUIRED - what a cluster's or endpoint's `section` field refers to
#   label    REQUIRED - the heading on the page
#   sublabel optional

SECTION_1=key=prod; label=Prod; sublabel=AKS
SECTION_2=key=demo; label=Demo

# --- Kubernetes clusters -------------------------------------------------
# Every Deployment and StatefulSet in the cluster is listed by itself.
# k8s/README.md shows how to create the read-only account and prints these
# three lines for you. Until _TOKEN and _CA are filled in, the cluster is
# skipped and the rest of the board works as normal.
#
# K8S_CLUSTER_<n>=section=<section key>; server=<API server address>
#                 [; namespaces=<a,b>] [; excludeNamespaces=<a,b>]
# K8S_CLUSTER_<n>_TOKEN=<ServiceAccount token>
# K8S_CLUSTER_<n>_CA=<cluster CA certificate, base64>
#
#   namespaces        only show these (default: all except AKS system namespaces)
#   excludeNamespaces hide these too
#
# Testing on your own machine before the account exists: point `server` at a
# running `kubectl proxy` (http://127.0.0.1:8001) and leave _TOKEN and _CA
# empty - see "Trying it first" in k8s/README.md.

K8S_CLUSTER_1=section=prod; server=https://<prod-cluster>.hcp.<region>.azmk8s.io:443
K8S_CLUSTER_1_TOKEN=
K8S_CLUSTER_1_CA=

K8S_CLUSTER_2=section=demo; server=https://<demo-cluster>.hcp.<region>.azmk8s.io:443
K8S_CLUSTER_2_TOKEN=
K8S_CLUSTER_2_CA=

# --- HTTP endpoints ------------------------------------------------------
# For what doesn't run in a cluster - the remaining Heroku apps. They can go
# in any section, including one a cluster fills: here they're listed in Demo,
# alongside its cluster services. Putting "(Heroku)" in the name keeps them
# recognisable there.
#
# ENDPOINT_<n>=name=<name>; url=<url>; section=<section key> [; expectedStatus=<code>]
#
#   name           REQUIRED - shown on the page, and the key for this
#                  endpoint's logged history, so renaming one orphans it
#   url            REQUIRED - the address to check
#   section        REQUIRED - a SECTION_<n> key
#   expectedStatus HTTP status that counts as "up" (default 200)

ENDPOINT_1=name=Auth Service (Heroku); url=https://auth.example.com/health; section=demo
ENDPOINT_2=name=Alarm Pulse (Heroku); url=https://alarm.example.com/pulse; section=demo; expectedStatus=400

# --- Azure Service Bus ---------------------------------------------------
# One entry per namespace; every queue in it is read automatically, and the
# ones with dead-lettered messages are listed. The connection string needs
# Manage rights (listing queues requires it) - in the Portal: the namespace →
# Shared access policies → RootManageSharedAccessKey → Primary Connection String.
#
# SERVICE_BUS_<n>=label=<name shown next to its queues>
# SERVICE_BUS_<n>_CONNECTION_STRING=<connection string, verbatim>

SERVICE_BUS_1=label=my-namespace-dev
SERVICE_BUS_1_CONNECTION_STRING=

SERVICE_BUS_2=label=my-namespace-prod
SERVICE_BUS_2_CONNECTION_STRING=
