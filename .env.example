# Copy this file to .env and fill it in. .env is gitignored - it never gets
# committed, which is the point: the service URLs live there, not in the repo.
#
# Format: plain KEY=VALUE lines. List entries are numbered and hold their own
# `field=value` pairs separated by semicolons, so field order doesn't matter
# and optional fields can just be left out. The numbering only sets the order
# entries are read in - gaps are fine. Values must not contain a semicolon.
#
# See the comment block at the top of config.js for what every field means.

# --- setup ---------------------------------------------------------------
# All optional; the defaults shown here are what you get if you omit them.

PORT=8080
REFRESH_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=5
HISTORY_POINTS=50
RETENTION_DAYS=10

# Needed for the queue counts. Without it the queues section is skipped.
SERVICE_BUS_CONNECTION_STRING=

# --- columns of the matrix, left to right --------------------------------
# COLUMN_<n>=key=<key>; label=<heading>; sublabel=<subheading>
#   key      REQUIRED - what an endpoint's `column` field refers to
#   label    REQUIRED - the column heading on the page
#   sublabel optional

COLUMN_1=key=current; label=Current; sublabel=Heroku
COLUMN_2=key=demo; label=K8s Demo; sublabel=Kubernetes
COLUMN_3=key=prod; label=K8s Prod; sublabel=Kubernetes

# --- endpoints -----------------------------------------------------------
# ENDPOINT_<n>=name=<unique name>; url=<url>; category=<heading>
#              [; service=<row>] [; column=<column key>] [; expectedStatus=<code>]
#
#   name           REQUIRED - unique, and the key for this endpoint's logged
#                  history, so renaming one orphans its history
#   url            REQUIRED - the address to check
#   category       row group heading (default "Other"). Sections appear in the
#                  order their first service appears in this list.
#   service        the row this endpoint joins (default: same as name). Two
#                  entries sharing a service sit side by side on one row.
#   column         a COLUMN_<n> key (default "current")
#   expectedStatus HTTP status that counts as "up" (default 200)

ENDPOINT_1=name=Auth Service; url=https://auth.example.com/health; category=Core Services
ENDPOINT_2=name=Alarm Pulse; url=https://alarm.example.com/pulse; category=Core Services; expectedStatus=400

# Same service in a second column - shares the row with ENDPOINT_1:
ENDPOINT_3=name=Auth Service (DEMO); service=Auth Service; column=demo; url=http://auth-demo.example.com/healthz; category=Core Services

# --- Azure Service Bus queues --------------------------------------------
# QUEUE_<n>=name=<card label>; queueName=<queue in the namespace>
# Both fields REQUIRED. Omit these entirely for no queue cards.

QUEUE_1=name=Orders; queueName=orders
QUEUE_2=name=Notifications; queueName=notifications
